 # .env.example
   # Copia este archivo a .env y rellena los valores.
   # .env está en .gitignore (nunca se commitean secretos).

   # ── Entorno ────────────────────────────────────────────────────────────
   # production | development | test. Default: production.
   # En production el servidor MCP se niega a arrancar sin MCP_ACCESS_TOKEN y
   # rechaza un bind wildcard. Usá development para correr sin token en loopback.
   APP_ENV=production


   # ── Neo4j ──────────────────────────────────────────────────────────────
   NEO4J_URI=bolt://localhost:7687
   NEO4J_USER=neo4j
   NEO4J_PASSWORD=tu_password_neo4j

   NEO4J_BROWSER_PORT=7474
   NEO4J_BOLT_PORT=7687

   NEO4J_BOLT_ADVERTISED_ADDRESS=localhost:7687
   NEO4J_HTTP_ADVERTISED_ADDRESS=localhost:7474

   NEO4J_PLUGINS=["apoc"]


   # ── LLM por responsabilidad ──────────────────────────────────────────
   # Construcción del grafo: DeepSeek
   GRAPH_LLM_API_KEY=TU_API_KEY_DEEPSEEK
   GRAPH_LLM_BASE_URL=https://api.deepseek.com/v1
   GRAPH_LLM_MODEL_NAME=deepseek-v4-pro

   # Preguntas del usuario: DeepSeek (el mismo proveedor que producción).
   # Un clon nuevo debe poder correr ask_global como el host; apuntarlo a otro
   # proveedor hace que las respuestas no sean comparables con las de producción.
   QUERY_LLM_API_KEY=TU_API_KEY_DEEPSEEK
   QUERY_LLM_BASE_URL=https://api.deepseek.com/v1
   QUERY_LLM_MODEL_NAME=deepseek-v4-flash


   # ── Compatibilidad legacy ─────────────────────────────────────────────
   # No usar estas variables. Se dejan comentadas para evitar ambigüedad.
   # LLM_API_KEY=
   # LLM_BASE_URL=
   # LLM_MODEL_NAME=


   # ── Procesamiento de PDF ───────────────────────────────────────────────
   PDF_MAX_CHUNK_SIZE=1500
   PDF_CHUNK_OVERLAP=150


   # ── Orquestación ───────────────────────────────────────────────────────
   LLM_MAX_CONCURRENCY=3
   PROCESSING_BATCH_SIZE=5

   DEAD_LETTER_PATH=data/dead_letter.log
   DEAD_LETTER_PATH_ORPHANS=data/dead_letter_orphans.jsonl


   # ── Reintentos ─────────────────────────────────────────────────────────
   LLM_MAX_RETRIES=3
   LLM_RETRY_WAIT_MULTIPLIER=1.0
   LLM_RETRY_WAIT_MAX=30.0
   LLM_INSTRUCTOR_MAX_RETRIES=1


   # ── Text-to-Cypher ─────────────────────────────────────────────────────
   TEXT2CYPHER_TIMEOUT=10


   # ── Community summaries ────────────────────────────────────────────────
   MAX_CLUSTER_SIZE=10
   SUMMARY_MAX_CONCURRENCY=6
   COMMUNITY_MAX_CALLS=300
   SUMMARY_REQUEST_DELAY=0.0
   SUMMARY_CHUNK_TOKENS=12000

   # ask_global: cuántos resúmenes entran al contexto y cuántos por llamada de scoring.
   # Medido 2026-10-11: la latencia la manda DETAIL_LEVEL, no la concurrencia — nivel 0
   # son 2 llamadas y 4-7 s, nivel 1 son 7 llamadas y 33-40 s. Subir SUMMARY_MAX_CONCURRENCY
   # de 3 a 6 no cambió nada medible (los lotes ya entran en una sola tanda).
   ASK_GLOBAL_TOP_N=8
   ASK_GLOBAL_SCORE_BATCH_SIZE=20


   # ── Router de namespaces ───────────────────────────────────────────────
   # Medido: acierta el 100% de las veces que se compromete (15/15, ningún libro
   # equivocado) con 8/9 abstenciones correctas, pero ningún caller usa el adapter
   # todavía, así que prenderlo no cambia nada hoy.
   ROUTER_ENABLED=false
   ROUTER_TELEMETRY_ENABLED=false


   # ── MCP server ─────────────────────────────────────────────────────────
   # Private bind only (R7): loopback by default; use the Tailscale IP in production.
   MCP_BIND_HOST=127.0.0.1
   MCP_PORT=8003
   MCP_LOG_PATH=logs/mcp_queries.jsonl
   MCP_LOG_RETENTION_DAYS=7

   # Bearer token for both transports (/mcp and /sse). REQUIRED IN PRODUCTION:
   # without a real one the server refuses to start (fail-closed), because the bearer
   # middleware is only installed when this value is a credential: at least 32
   # characters, and at least one of them printable. A blank, invisible or short value
   # counts as no token. Outside production such a server starts with a warning and is
   # only acceptable on a loopback bind.
   # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"   # 43 chars
   MCP_ACCESS_TOKEN=

   # Keyed HMAC-SHA256 query/prompt fingerprints (R5). Fail-closed: an empty key
   # raises a QueryFingerprintError at fingerprint time — never plaintext logging.
   # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
   MCP_HMAC_KEY_ID=mcp-log-v1
   MCP_HMAC_KEY=

   # Dynamic text-to-Cypher (query_cypher) is fail-closed by default; must be
   # explicitly enabled to reach the LLM/graph path.
   MCP_ENABLE_QUERY_CYPHER=false

   # Fail-closed scope boundary (R3): every structured/LLM-mediated request must
   # carry a validated ScopeContext. Only disable for legacy unscoped callers.
   MCP_REQUIRE_SCOPE=true

   # Raw query logging is development-only (R5). Enabling it requires
   # APP_ENV=development; rejected under production/test settings.
   MCP_RAW_LOGGING_ENABLED=false


   # ── Skill quality gate ─────────────────────────────────────────────────
   # MCP tool surface. Off by default on purpose: the gate is fail-closed, so enabling
   # it before the skills are seeded (scripts/seed_skill_scores.py) would expose an
   # empty tool set instead of all eight. Turn it on in the host .env only after the
   # seeding run and the readiness gate.
   SKILL_GATE_ENABLED=false
   SKILL_MIN_QUALITY=0.60
   # The cap must cover the catalog: five capabilities are seeded, so a cap of 3 would
   # silently drop the lowest-scoring one and take its tools out of the surface with it.
   SKILL_TOP_K=5
   SKILL_SAFETY_HIGH_TIER_CAP=0.40
