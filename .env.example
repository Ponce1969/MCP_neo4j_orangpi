# .env.example — MCP OranPi Configuration
# Copy this file to .env and fill in the required values.
# NEVER commit .env to the repository.

# === Required ===
ORANPI_SSH_HOST=oranpi.local
ORANPI_SSH_USER=cerra
ORANPI_SSH_KEY_PATH=~/.ssh/id_oranpi

# === Required (Workspace) ===
ORANPI_ROOT_WORKSPACE_DIR=/home/cerra/codigo

# === Optional with Defaults ===
ORANPI_SSH_PORT=22
ORANPI_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
ORANPI_SSH_HOST_KEY_POLICY=strict
ORANPI_SSH_SECURITY_MODE=production
ORANPI_SSH_CONNECT_TIMEOUT=10
ORANPI_SSH_COMMAND_TIMEOUT=30

# === Logging ===
ORANPI_LOG_LEVEL=INFO

# === Workspace ===
ORANPI_WORKSPACE_CONFIG=workspaces.yaml

# === Output Limits ===
ORANPI_ALLOWED_LOG_DIRS=/var/log,/home,/opt
ORANPI_LOG_OUTPUT_LIMIT_KB=50
ORANPI_MAX_PAYLOAD_KB=1024
ORANPI_MAX_LOG_FILE_MB=50